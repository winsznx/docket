{
  "color": {
    "daylight": "#FFFFFF",
    "register": "#182C70",
    "registerSoft": "#4A5785",
    "wash": "#F3F5FA",
    "danfo": "#FFC928",
    "go": "#0A7A45",
    "missed": "#B42318",
    "night": "#0B1440",
    "nightSoft": "#A9B3D6",
    "registerLift": "#24398F"
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192],
  "radius": {
    "ticket": 28,
    "ticketHero": 32,
    "input": 14,
    "sheet": 28,
    "pill": 999
  },
  "notch": 14,
  "shadow": {
    "ticket": [
      { "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "night", "alpha": 0.08 },
      { "x": 0, "y": 24, "blur": 48, "spread": -12, "color": "night", "alpha": 0.18 }
    ]
  },
  "motion": {
    "duration": {
      "press": 120,
      "state": 240,
      "ticket": 480
    },
    "easing": [0.2, 0.7, 0.2, 1]
  },
  "font": {
    "sans": {
      "name": "Atkinson Hyperlegible Next",
      "flutterFamily": "AtkinsonHyperlegibleNext",
      "fallback": ["system-ui", "sans-serif"]
    },
    "mono": {
      "name": "Atkinson Hyperlegible Mono",
      "flutterFamily": "AtkinsonHyperlegibleMono",
      "fallback": ["ui-monospace", "monospace"]
    }
  },
  "type": {
    "site": {
      "display": {
        "size": "clamp(3rem, 2rem + 5vw, 7.5rem)",
        "leading": 0.95,
        "weight": 800,
        "trackingEm": -0.02
      },
      "heading": {
        "size": "clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem)",
        "leading": 1.1,
        "weight": 700
      },
      "subheading": {
        "size": "1.375rem",
        "leading": 1.25,
        "weight": 700
      },
      "lead": {
        "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem)",
        "leading": 1.45,
        "weight": 400
      },
      "body": {
        "size": "1.125rem",
        "leading": 1.6,
        "weight": 400
      },
      "small": {
        "size": "0.9375rem",
        "leading": 1.5,
        "weight": 500
      }
    },
    "phone": {
      "ticketLabelMin": 96,
      "ticketLabelMax": 128,
      "headline": 32,
      "body": 18,
      "small": 15
    }
  }
}
